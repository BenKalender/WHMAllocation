@page "/dashboard"
@rendermode InteractiveServer
@using WHMAllocation.App.Display
@using WHMAllocation.Infrastructure.Persistence.Seed
@inject IOrderRepository OrderRepository
@inject ISkuRepository SkuRepository
@inject DatabaseSeeder Seeder

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">
  <div class="page-heading">
    <div class="page-heading-copy">
      <span class="page-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
      <div>
        <p class="eyebrow mb-1">Overview</p>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">
          Stock allocation, cancellation and inventory correction across the warehouse.
        </p>
      </div>
    </div>
    <div class="ms-auto">
      <button class="btn btn-light" type="button" @onclick="ResetAsync" disabled="@_isBusy">
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset demo data
      </button>
    </div>
  </div>

  @if (_resetMessage is not null)
  {
    <div class="alert alert-success mt-3" role="alert">@_resetMessage</div>
  }

  <section class="row g-3 mt-1" aria-label="Warehouse metrics">
    <div class="col-12 col-sm-6 col-xl-3">
      <article class="metric-card metric-primary">
        <div class="metric-top">
          <span class="metric-label">Released Orders</span>
          <span class="metric-icon"><i class="fs-3 bi bi-box-seam-fill text-info"></i></span>
        </div>
        <div class="metric-value">@Count(OrderStatus.Released)</div>
        <div class="metric-meta">
          <span class="text-primary">Waiting for allocation</span>
          <span>Run allocation to reserve stock</span>
        </div>
      </article>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <article class="metric-card metric-success">
        <div class="metric-top">
          <span class="metric-label">Allocated Orders</span>
          <span class="metric-icon"><i class="fs-3 bi bi-bag-check" aria-hidden="true"></i></span>
        </div>
        <div class="metric-value">@Count(OrderStatus.Allocated)</div>
        <div class="metric-meta">
          <span class="text-success">Fully reserved</span>
          <span>Ready for delivery</span>
        </div>
      </article>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <article class="metric-card metric-danger">
        <div class="metric-top">
          <span class="metric-label">Stock Issues</span>
          <span class="metric-icon"><i class="fs-3 bi-exclamation-triangle-fill text-danger"></i></span>
        </div>
        <div class="metric-value">@Count(OrderStatus.PartiallyAllocated)</div>
        <div class="metric-meta">
          <span class="text-danger">Partially allocated</span>
          <span>Holding less than requested</span>
        </div>
      </article>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <article class="metric-card metric-warning">
        <div class="metric-top">
          <span class="metric-label">Locked Locations</span>
          <span class="metric-icon"><i class="fs-3 bi bi-building-lock text-warning"></i></span>
        </div>
        <div class="metric-value">@_lockedLocations</div>
        <div class="metric-meta">
          <span class="text-secondary">@_lockedStock unit(s) unavailable</span>
          <span>Never allocated</span>
        </div>
      </article>
    </div>
  </section>

  <section class="row g-3 mt-1">
    <div class="col-12 col-xl-8">
      <div class="panel h-100">
        <div class="panel-header">
          <div>
            <h2 class="h5 mb-1 section-title">
              <i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>Order Status Overview</span>
            </h2>
            <p class="text-muted mb-0">Where every order currently stands.</p>
          </div>
          <a class="btn btn-light btn-sm" href="/orders">View orders</a>
        </div>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <tbody>
              @foreach (var status in _statuses)
              {
                var count = Count(status);
                var share = _orders.Count == 0 ? 0 : (int)Math.Round(count * 100.0 / _orders.Count);

                <tr>
                  <td style="width: 12rem;">
                    <span class="badge @Badges.ForStatus(status)">@Badges.StatusText(status)</span>
                  </td>
                  <td>
                    <div class="progress" role="progressbar" aria-label="@Badges.StatusText(status)"
                         aria-valuenow="@share" aria-valuemin="0" aria-valuemax="100" style="height: .5rem;">
                      <div class="progress-bar" style="width: @(share)%"></div>
                    </div>
                  </td>
                  <td class="text-end fw-semibold" style="width: 5rem;">@count</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4">
      <div class="panel h-100">
        <div class="panel-header">
          <div>
            <h2 class="h5 mb-1 section-title">
              <i class="bi bi-pie-chart" aria-hidden="true"></i><span>Order Priority</span>
            </h2>
            <p class="text-muted mb-0">Allocation order, highest first.</p>
          </div>
        </div>
        <div class="donut-chart mx-auto"><span>@AllocatedShare%</span></div>
        <p class="text-center text-muted small mt-2 mb-0">of orders fully allocated</p>
        <div class="legend-list mt-3">
          <div><span class="legend-dot bg-danger"></span>High<strong>@CountPriority(Priority.High)</strong></div>
          <div><span class="legend-dot bg-warning"></span>Normal<strong>@CountPriority(Priority.Normal)</strong></div>
          <div><span class="legend-dot bg-secondary"></span>Low<strong>@CountPriority(Priority.Low)</strong></div>
        </div>
      </div>
    </div>
  </section>
</div>

@code {
    private List<Order> _orders = [];
    private int _lockedLocations;
    private int _lockedStock;
    private string? _resetMessage;
    private bool _isBusy;

    private static readonly OrderStatus[] _statuses =
    [
        OrderStatus.Released,
        OrderStatus.Allocated,
        OrderStatus.PartiallyAllocated,
        OrderStatus.Cancelled
    ];

    private int Count(OrderStatus status) => _orders.Count(x => x.Status == status);

    private int CountPriority(Priority priority) => _orders.Count(x => x.Priority == priority);

    private int AllocatedShare =>
        _orders.Count == 0 ? 0 : (int)Math.Round(Count(OrderStatus.Allocated) * 100.0 / _orders.Count);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _orders = await OrderRepository.GetAllAsync();

        var skus = await SkuRepository.GetAllAsync();

        var lockedSkus = skus.Where(x => x.WarehouseLocation?.IsLocked == true).ToList();

        _lockedLocations = lockedSkus
            .Select(x => x.WarehouseLocationId)
            .Distinct()
            .Count();

        _lockedStock = lockedSkus.Sum(x => x.Quantity);
    }

    private async Task ResetAsync()
    {
        _isBusy = true;

        try
        {
            await Seeder.ResetAsync();

            await LoadAsync();

            _resetMessage = "Demo data reset. All orders are Released again and stock is back to its starting quantities.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
