@page "/orders/{OrderId:guid}"
@rendermode InteractiveServer
@using WHMAllocation.App.Display
@inject IOrderRepository OrderRepository
@inject IOrderCancellationService CancellationService

<PageTitle>Order detail</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">

  @if (_order is null)
  {
    <div class="panel">
      <p class="text-muted mb-0">@(_loaded ? "Order not found." : "Loading…")</p>
      <a class="btn btn-light btn-sm mt-3" href="/orders">Back to orders</a>
    </div>
  }
  else
  {
    <div class="page-heading">
      <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
        <div>
          <p class="eyebrow mb-1">Scenario 2</p>
          <h1 class="h3 mb-1">@_order.OrderNumber</h1>
          <p class="text-muted mb-0">
            Cancelling releases allocated stock back to its SKU so other orders can use it.
          </p>
        </div>
      </div>
      <div class="ms-auto d-flex gap-2">
        <a class="btn btn-light" href="/orders"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a>
        <button class="btn btn-danger" type="button" @onclick="CancelOrderAsync" disabled="@(_isBusy || IsCancelled)">
          <i class="bi bi-x-circle" aria-hidden="true"></i> Cancel Order
        </button>
      </div>
    </div>

    @if (_result is not null)
    {
      <div class="alert @Badges.ForCancellation(_result) mt-3" role="alert">
        @Badges.Describe(_result)
      </div>
    }

    <section class="row g-3 mt-1">
      <div class="col-12 col-sm-6 col-xl-3">
        <article class="metric-card metric-primary">
          <div class="metric-top">
            <span class="metric-label">Status</span>
            <span class="metric-icon"><i class="fs-3 bi bi-flag" aria-hidden="true"></i></span>
          </div>
          <div class="metric-value">
            <span class="badge @Badges.ForStatus(_order.Status)">@Badges.StatusText(_order.Status)</span>
          </div>
        </article>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <article class="metric-card metric-warning">
          <div class="metric-top">
            <span class="metric-label">Priority</span>
            <span class="metric-icon"><i class="fs-3 bi bi-sort-down" aria-hidden="true"></i></span>
          </div>
          <div class="metric-value">
            <span class="badge @Badges.ForPriority(_order.Priority)">@_order.Priority</span>
          </div>
        </article>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <article class="metric-card metric-success">
          <div class="metric-top">
            <span class="metric-label">Allocated</span>
            <span class="metric-icon"><i class="fs-3 bi bi-bag-check" aria-hidden="true"></i></span>
          </div>
          <div class="metric-value">@AllocatedQuantity / @RequestedQuantity</div>
        </article>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <article class="metric-card metric-danger">
          <div class="metric-top">
            <span class="metric-label">Complete Delivery</span>
            <span class="metric-icon"><i class="fs-3 bi bi-truck" aria-hidden="true"></i></span>
          </div>
          <div class="metric-value">@(_order.CompleteDeliveryRequired ? "Required" : "Not required")</div>
          <div class="metric-meta">
            <span class="text-secondary">
              @(_order.CompleteDeliveryRequired ? "All or nothing" : "Partial delivery allowed")
            </span>
          </div>
        </article>
      </div>
    </section>

    <section class="panel mt-3">
      <div class="panel-header">
        <div>
          <h2 class="h5 mb-1 section-title">
            <i class="bi bi-list-ul" aria-hidden="true"></i><span>Order Lines</span>
          </h2>
          <p class="text-muted mb-0">Each line shows the SKUs its stock was reserved from.</p>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Requested</th>
              <th scope="col">Allocated From</th>
              <th scope="col">Line Status</th>
              <th scope="col" class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var line in _order.OrderLines)
            {
              var activeAllocations = line.Allocations.Where(x => x.IsActive).ToList();

              <tr>
                <td>
                  <p class="fw-semibold mb-0">@(line.Product?.Name ?? "Unknown")</p>
                  <p class="text-muted small mb-0">@(line.Product?.ProductNumber ?? "-")</p>
                </td>
                <td class="fw-semibold">@line.RequestedQuantity</td>
                <td>
                  @if (activeAllocations.Count == 0)
                  {
                    <span class="text-muted small">Nothing reserved</span>
                  }
                  else
                  {
                    @foreach (var allocation in activeAllocations)
                    {
                      <div class="small">
                        <span class="fw-semibold">@allocation.Quantity</span>
                        <span class="text-muted">
                          from @(allocation.Sku?.WarehouseLocation?.Code ?? "unknown location")
                        </span>
                      </div>
                    }
                  }
                </td>
                <td>
                  @if (line.IsCancelled)
                  {
                    <span class="badge text-bg-secondary">Cancelled</span>
                  }
                  else if (activeAllocations.Sum(x => x.Quantity) >= line.RequestedQuantity)
                  {
                    <span class="badge text-bg-success">Covered</span>
                  }
                  else if (activeAllocations.Count > 0)
                  {
                    <span class="badge text-bg-warning">Short</span>
                  }
                  else
                  {
                    <span class="badge text-bg-info">Awaiting stock</span>
                  }
                </td>
                <td class="text-end">
                  <button class="btn btn-outline-secondary btn-sm" type="button"
                          @onclick="() => CancelLineAsync(line.Id)"
                          disabled="@(_isBusy || line.IsCancelled || IsCancelled)">
                    <i class="bi bi-x" aria-hidden="true"></i> Cancel Line
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </section>
  }
</div>

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private Order? _order;
    private CancellationResult? _result;
    private bool _isBusy;
    private bool _loaded;

    private bool IsCancelled => _order?.Status == OrderStatus.Cancelled;

    private int RequestedQuantity =>
        _order?.OrderLines.Where(x => !x.IsCancelled).Sum(x => x.RequestedQuantity) ?? 0;

    private int AllocatedQuantity =>
        _order?.OrderLines.SelectMany(x => x.Allocations).Where(x => x.IsActive).Sum(x => x.Quantity) ?? 0;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _order = await OrderRepository.GetDetailAsync(OrderId);
        _loaded = true;
    }

    private async Task CancelOrderAsync()
    {
        _isBusy = true;

        try
        {
            _result = await CancellationService.CancelOrderAsync(OrderId);

            await LoadAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CancelLineAsync(Guid orderLineId)
    {
        _isBusy = true;

        try
        {
            _result = await CancellationService.CancelOrderLineAsync(orderLineId);

            await LoadAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
}
