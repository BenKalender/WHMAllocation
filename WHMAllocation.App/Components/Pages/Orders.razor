@page "/orders"
@rendermode InteractiveServer
@using WHMAllocation.App.Display
@inject IOrderRepository OrderRepository
@inject IAllocationService AllocationService

<PageTitle>Orders</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-4">
  <div class="page-heading">
    <div class="page-heading-copy">
      <span class="page-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
      <div>
        <p class="eyebrow mb-1">Scenario 1</p>
        <h1 class="h3 mb-1">Orders</h1>
        <p class="text-muted mb-0">
          Released orders are allocated highest priority first, and oldest first within a priority.
        </p>
      </div>
    </div>
    <div class="ms-auto">
      <button class="btn btn-primary" type="button" @onclick="RunAllocationAsync" disabled="@_isRunning">
        @if (_isRunning)
        {
          <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
          <span>Allocating…</span>
        }
        else
        {
          <i class="bi bi-lightning-charge" aria-hidden="true"></i>
          <span> Run Allocation</span>
        }
      </button>
    </div>
  </div>

  @if (_runResult is not null)
  {
    <div class="alert @Badges.ForRun(_runResult) mt-3" role="alert">
      <div class="fw-semibold mb-1">
        Allocation run finished — @_runResult.OrdersProcessed order(s) processed,
        @_runResult.TotalQuantityAllocated unit(s) allocated.
      </div>
      <div class="small">
        @_runResult.FullyAllocatedCount fully allocated ·
        @_runResult.PartiallyAllocatedCount partially allocated ·
        @_runResult.SkippedCount skipped
      </div>

      @if (_runResult.Orders.Any(x => x.IsSkipped))
      {
        <hr />
        <div class="small mb-1 fw-semibold">Skipped</div>
        <ul class="small mb-0 ps-3">
          @foreach (var skipped in _runResult.Orders.Where(x => x.IsSkipped))
          {
            <li>@skipped.OrderNumber — @Badges.Describe(skipped.Outcome)</li>
          }
        </ul>
      }
    </div>
  }

  @*
    Filter and sort once per render: the markup reads the result in three places, and a
    computed property would redo the whole pass each time.
  *@
  @{
    var filter = OrderQuery.ParseFilter(_filterText);
    var visibleOrders = OrderQuery
        .Sort(_orders.Where(x => OrderQuery.Matches(x, filter)), _sortColumn, _sortDescending)
        .ToList();
  }

  <section class="panel mt-3">
    <div class="panel-header">
      <div>
        <h2 class="h5 mb-1 section-title">
          <i class="bi bi-list-ul" aria-hidden="true"></i><span>All Orders</span>
        </h2>
        <p class="text-muted mb-0">
          @if (filter.IsEmpty)
          {
            @($"{_orders.Count} order(s) in the warehouse.")
          }
          else
          {
            @($"{visibleOrders.Count} of {_orders.Count} order(s) match this filter.")
          }
        </p>
      </div>
      <input class="form-control search-input table-search" type="search"
             placeholder="priority:high status:released"
             aria-label="Filter orders"
             @bind="_filterText" @bind:event="oninput" />
    </div>

    <div class="table-responsive">
      <table class="table align-middle mb-0" id="ordersTable">
        <thead>
          <tr>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.Number)">
              <SortHeader Column="OrderSortColumn.Number" Label="Order"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.Priority)">
              <SortHeader Column="OrderSortColumn.Priority" Label="Priority"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.CompleteDelivery)">
              <SortHeader Column="OrderSortColumn.CompleteDelivery" Label="Complete Delivery"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.Status)">
              <SortHeader Column="OrderSortColumn.Status" Label="Status"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.Allocated)">
              <SortHeader Column="OrderSortColumn.Allocated" Label="Allocated"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" aria-sort="@AriaSort(OrderSortColumn.Created)">
              <SortHeader Column="OrderSortColumn.Created" Label="Created"
                          Active="_sortColumn" Descending="_sortDescending" OnSort="SortBy" />
            </th>
            <th scope="col" class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var order in visibleOrders)
          {
            var requested = OrderQuery.RequestedQuantity(order);
            var allocated = OrderQuery.AllocatedQuantity(order);

            <tr>
              <td>
                <div>
                  <p class="fw-semibold mb-0">@order.OrderNumber</p>
                  <p class="text-muted small mb-0">@LineSummary(order)</p>
                </div>
              </td>
              <td><span class="badge @Badges.ForPriority(order.Priority)">@order.Priority</span></td>
              <td>
                @if (order.CompleteDeliveryRequired)
                {
                  <span class="fw-semibold text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> Yes</span>
                }
                else
                {
                  <span class="text-muted"><i class="bi bi-dash-circle" aria-hidden="true"></i> No</span>
                }
              </td>
              <td>
                <span class="badge @Badges.ForStatus(order.Status)">@Badges.StatusText(order.Status)</span>
              </td>
              <td>
                <span class="fw-semibold">@allocated</span>
                <span class="text-muted small"> / @requested</span>
              </td>
              <td class="text-muted small">@order.CreatedAt.ToString("dd MMM yyyy")</td>
              <td class="text-end">
                <a class="btn btn-secondary btn-sm" href="@($"/orders/{order.Id}")">
                  <i class="bi bi-eye" aria-hidden="true"></i> View
                </a>
              </td>
            </tr>
          }

          @if (visibleOrders.Count == 0)
          {
            <tr>
              <td colspan="7" class="text-center text-muted py-4">
                <p class="mb-2">No orders match this filter.</p>
                <p class="small mb-1">Try:</p>
                <p class="small mb-0"><code>priority:</code> low | normal | high</p>
                <p class="small mb-0"><code>status:</code> released | allocated | partial | cancelled</p>
                <p class="small mb-0"><code>complete:</code> yes | no</p>
                <p class="small mb-0"><code>allocated:</code> none | partial | full</p>
                <p class="small mb-0 mt-2">Anything without a colon searches order number and product.</p>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>

@code {
    private List<Order> _orders = [];
    private AllocationRunResult? _runResult;
    private bool _isRunning;

    private string? _filterText;
    private OrderSortColumn _sortColumn = OrderSortColumn.Priority;
    private bool _sortDescending = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _orders = await OrderRepository.GetAllAsync();

    private async Task RunAllocationAsync()
    {
        _isRunning = true;

        try
        {
            _runResult = await AllocationService.AllocateReleasedOrdersAsync();

            await LoadAsync();
        }
        finally
        {
            _isRunning = false;
        }
    }

    /// <summary>Clicking the active column flips direction; a new column starts at its natural one.</summary>
    private void SortBy(OrderSortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = OrderQuery.DefaultDescendingFor(column);
    }

    private string AriaSort(OrderSortColumn column) =>
        _sortColumn != column ? "none" : _sortDescending ? "descending" : "ascending";

    private static string LineSummary(Order order)
    {
        var lines = order.OrderLines
            .Where(x => !x.IsCancelled)
            .Select(x => $"{x.Product?.Name ?? "Unknown"} ({x.RequestedQuantity})")
            .ToList();

        return lines.Count == 0 ? "No live lines" : string.Join(", ", lines);
    }
}
